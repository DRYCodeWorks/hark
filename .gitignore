.venv/
__pycache__/
*.pyc
.pytest_cache/
*.wav.tmp
.DS_Store

# Agent / SDD scaffolding — local workflow, not part of the project.
.superpowers/

# Rendered launchd plists. Only the .plist.template files are tracked; a
# rendered plist contains the invoking user's absolute paths and bind address.
launchd/*.plist

# A real config, if anyone puts one here instead of ~/.config/tacet/.
# config.example.toml is the tracked one.
config.toml

# Local migration notes, not part of the project.
LAPTOP-MIGRATION.local.md

# SwiftPM build artifacts (the Swift rewrite).
swift/.build/

# Generated app bundle (rebuilt by swift/Packaging/build-app.sh).
swift/Packaging/Tacet.app/

# Stray build output. The packaging script regenerates this.
build/
