<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.drycodeworks.whisper-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>@WHISPER_SERVER@</string>
    <string>--model</string>
    <string>@MODEL@</string>
    <string>--host</string>
    <string>@WHISPER_HOST@</string>
    <string>--port</string>
    <string>@WHISPER_PORT@</string>
    <string>--language</string>
    <string>en</string>
    <string>--no-timestamps</string>
    <string>--suppress-nst</string>
    <string>--prompt</string>
    <string>@PROMPT@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/whisper-server.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/whisper-server.err</string>
</dict>
</plist>
